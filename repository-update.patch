@@ -0,0 +1,134 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRequire } from 'node:module';
+import { fileURLToPath } from 'node:url';
+import { CONFIG, MARKETS, MARKET_DOSSIERS, ROUNDS } from '../src/scenario.mjs';
+import { lockRound, updateDraft, replay } from '../src/rules.mjs';
+import { reportHtml } from '../src/report.mjs';
+
+function record(market = 'indonesia') {
+  return {game: CONFIG.game, version: CONFIG.version, mode: 'practice', team: 1, market,
+    room: 'PRACTICE', session: 'report-test', history: [], drafts: {}, notes: {}, brief: '', bulletinB: false};
+}
+
+test('An unfinished report is a partial snapshot with no invented Board decision', () => {
+  const html = reportHtml(record(), 0);
+  assert.match(html, /Strategy in progress/);
+  assert.match(html, /0 \/ 7 decisions locked/);
+  assert.match(html, /Final funding decision not locked yet/);
+  assert.doesNotMatch(html, /Simulated game result/);
+});
+
+test('A complete report includes every decision, rationale, worksheet, actual spend and Board request', () => {
+  let current = record('philippines');
+  const choices = ['A', 'interview', 'pilot', 'reserve', 'keep', 'hold', 'defer'];
+  for (const round of ROUNDS) {
+    if (round.id === 'R6') current.bulletinB = true;
+    current = updateDraft(current, round.id, 'choice', choices[current.history.length], 0);
+    current = updateDraft(current, round.id, 'evidence', 'Evidence for ' + round.id, 0);
+    current = updateDraft(current, round.id, 'tradeoff', 'Trade-off for ' + round.id, 0);
+    current = lockRound(current, round.id, 0);
+  }
+  current.notes['R7.board'] = 'Fund the named Manila preparation milestone';
+  current.brief = 'Our Board Brief';
+  const html = reportHtml(current, 0);
+  const {state, path} = replay(current);
+  assert.ok(state.credits < CONFIG.budget);
+  assert.equal((html.match(/class="decision"/g) || []).length, 7);
+  assert.match(html, /Completed strategy/);
+  assert.match(html, /Fund the named Manila preparation milestone/);
+  assert.match(html, /Our Board Brief/);
+  assert.match(html, new RegExp('<strong>' + state.credits + '</strong><span>Credits remaining'));
+  for (const event of path) {
+    assert.ok(html.includes(event.result.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#39;')));
+    assert.ok(html.includes('Evidence for ' + event.round));
+    assert.ok(html.includes('Trade-off for ' + event.round));
+  }
+  assert.ok(html.includes(MARKET_DOSSIERS.philippines));
+});
+
+test('Team-authored text is rendered as text and cannot inject script or HTML into the report', () => {
+  const current = record();
+  current.brief = '<script>window.reportAttack=1</script><img src=x onerror=alert(1)>';
+  current.notes['R7.board'] = '<b>Ask</b> & "assumption"';
+  const html = reportHtml(current, 0);
+  assert.doesNotMatch(html, /<script>|<img src=x/);
+  assert.match(html, /&lt;script&gt;/);
+  assert.match(html, /&lt;b&gt;Ask&lt;\/b&gt; &amp; &quot;assumption&quot;/);
+});
+
+let chromium = null;
+try { ({chromium} = createRequire(import.meta.url)('playwright')); } catch { /* optional */ }
+const skip = !chromium && 'Playwright is not installed';
+const pageUrl = 'file://' + fileURLToPath(new URL('../one-market-first.html', import.meta.url));
+
+test('At phone width, all four teams open their own dossier and a separate, safe report with saved notes', {skip}, async () => {
+  const browser = await chromium.launch();
+  try {
+    for (const [market, data] of Object.entries(MARKETS)) {
+      const context = await browser.newContext({viewport: {width: 390, height: 844}});
+      const page = await context.newPage();
+      const errors = [];
+      page.on('pageerror', error => errors.push(error.message));
+      await page.goto(pageUrl);
+      await page.selectOption('[data-entry=market]', market);
+      await page.click('button:has-text("Open practice dashboard")');
+      await page.locator('.pv-sidebar summary', {hasText: 'Market dossier'}).click();
+      const links = await page.locator('.pv-sidebar a[href]').evaluateAll(items => items.map(a => a.href));
+      assert.ok(links.length >= 4);
+      assert.deepEqual([...new Set(links)], [MARKET_DOSSIERS[market]]);
+      await page.click('button[data-action=materials]');
+      const ruleLinks = await page.locator('[data-ui=materials-body] a[href]').evaluateAll(items => items.map(a => a.href));
+      assert.ok(ruleLinks.length >= 8);
+      assert.deepEqual([...new Set(ruleLinks)], [MARKET_DOSSIERS[market]]);
+      await page.click('button[data-action=close-materials]');
+      await page.locator('label.pv-choice .pv-choice-card').first().click();
+      await page.fill('textarea[data-draft=evidence]', 'Saved evidence <b>not markup</b>');
+      await page.fill('textarea[data-draft=tradeoff]', 'Saved trade-off');
+      await page.click('button:has-text("Lock this choice")');
+      const popupPromise = page.waitForEvent('popup');
+      await page.click('button[data-action=open-report]');
+      const report = await popupPromise;
+      await report.locator('h1').waitFor();
+      assert.equal(await report.locator('h1').innerText(), 'Team 1 · ' + data.name);
+      assert.ok((await report.locator('body').innerText()).includes('Saved evidence <b>not markup</b>'));
+      assert.equal(await report.locator('.note b').count(), 0);
+      assert.equal(await report.evaluate(() => window.opener), null);
+      assert.equal(await report.locator('textarea, input').count(), 0);
+      assert.equal(await report.evaluate(() => document.documentElement.scrollWidth <= innerWidth), true);
+      assert.equal(await report.locator('[data-report-print]').count(), 1);
+      assert.equal(await report.locator('a').getAttribute('href'), MARKET_DOSSIERS[market]);
+      await report.close();
+      assert.match(await page.locator('.pv-sidebar-card').first().innerText(), /Decision journal/);
+      assert.deepEqual(errors, []);
+      await context.close();
+    }
+  } finally { await browser.close(); }
+});
+
+test('The final report contains the latest Board Brief and reports a blocked tab without losing the game', {skip}, async () => {
+  const browser = await chromium.launch();
+  try {
+    const page = await browser.newPage();
+    await page.goto(pageUrl);
+    await page.click('button:has-text("Open practice dashboard")');
+    for (let i = 0; i < ROUNDS.length; i++) {
+      if (i === 5) await page.click('button[data-action=practice-b]');
+      await page.click('button[data-action=practice-default]');
+      await page.click('button[data-action=next-practice]');
+    }
+    await page.fill('textarea[data-brief]', 'Latest brief before opening the report');
+    const popupPromise = page.waitForEvent('popup');
+    await page.click('button[data-action=open-report]');
+    const report = await popupPromise;
+    await report.locator('h1').waitFor();
+    assert.match(await report.locator('main').innerText(), /Latest brief before opening the report/);
+    assert.equal(await report.locator('.decision').count(), 7);
+    assert.match(await report.locator('main').innerText(), /Completed strategy/);
+    await report.close();
+    await page.evaluate(() => { window.open = () => null; });
+    await page.click('button[data-action=open-report]');
+    await page.locator('[data-ui=notice]').filter({hasText: 'tab was blocked'}).waitFor();
+    assert.equal(await page.locator('textarea[data-brief]').inputValue(), 'Latest brief before opening the report');
+  } finally { await browser.close(); }
+});
